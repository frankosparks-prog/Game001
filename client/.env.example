# ==============================================================================
# Nairobi Pulse 3D: Next.js Client Environment Configuration (Template)
# Copy this file to .env.local and adjust values for your local environment.
# Note: Variables prefixed with NEXT_PUBLIC_ are baked into the browser bundle.
# ==============================================================================

# Backend REST API endpoint base URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Real-time WebSocket / Socket.IO game server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Application branding & title
NEXT_PUBLIC_APP_NAME="Maandamano 3D: Nairobi Pulse"

# Default protest trending hashtag for the HUD news ticker & tension state
NEXT_PUBLIC_DEFAULT_PROTEST_HASHTAG="#RejectFinanceBill2024"

# Client simulation tick rate (Hz)
NEXT_PUBLIC_CLIENT_TICK_HZ=60
