# ==============================================================================
# Nairobi Pulse 3D: Multiplayer Game Server Environment Configuration (Template)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Port the Express HTTP and Socket.IO server listens on
PORT=3001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed frontend client origin for Cross-Origin Resource Sharing (CORS)
# Use '*' during development or specify the client origin (e.g., http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Server Simulation Tick Rate in Hertz (Updates per second sent to clients)
SIMULATION_TICK_HZ=20

# Optional MongoDB Connection URI
# Leave empty to run with high-speed in-memory state (fast dev mode).
# Provide a MongoDB URI to persist accounts, user profiles, and saved protest placards.
# Example: mongodb://localhost:27017/nairobi_pulse
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nairobi_pulse?retryWrites=true&w=majority
MONGODB_URI=
